# Application settings
APP_NAME="Skycoach Reels Analyzer"
DEBUG=false
HOST="0.0.0.0"
PORT=8080

# Database
# Local SQLite with aiosqlite (WAL mode is enabled automatically in database.py)
DATABASE_URL="sqlite+aiosqlite:///./data/skycoach.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/skycoach"

# Redis queue
REDIS_URL="redis://localhost:6379/0"

# --- Universal OpenAI-Compatible Multimodal AI settings ---
# Supports OpenRouter, Alibaba DashScope, SiliconFlow, vLLM, OpenAI, etc.
AI_PROVIDER="openai_compatible"
OPENAI_API_KEY="your-api-key-here"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="qwen/qwen3.8-omni-flash"

# Optional provider aliases (for backward compatibility)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.8-omni-flash"
GEMINI_API_KEY=""

# yt-dlp cookies (Netscape cookies.txt) — needed when Instagram/YouTube block anonymous downloads
# In docker-compose put the file at ./cookies/cookies.txt
YTDLP_COOKIES_FILE=""
# Instagram session uploaded from the UI (block «Сессия Instagram") overrides the file above
IG_SESSION_FILE="./data/ig_session.txt"
# Pause between Instagram downloads: minimum + random jitter, seconds
IG_MIN_INTERVAL_SEC=15
IG_JITTER_SEC=10

# Limits & Timeouts
TASK_TIMEOUT_SECONDS=180
MAX_BATCH_URLS=20

# Optional proxy for anonymous YouTube downloads only (servers get YouTube's bot
# check). Never used for Instagram or together with cookies.
# YOUTUBE_PROXY="http://host:port"
